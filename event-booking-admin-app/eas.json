{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "REPLACE_SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "REPLACE_SUPABASE_ANON_KEY",
        "EXPO_PUBLIC_API_BASE_URL": "REPLACE_DEPLOYED_NEXT_APP_URL",
        "EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME": "REPLACE_OR_REMOVE",
        "EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET": "REPLACE_OR_REMOVE"
      }
    },
    "production": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    }
  }
}
