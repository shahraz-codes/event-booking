# Supabase credentials (same project as the Next.js web app)
EXPO_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# Base URL for write calls to the Next.js admin API
# - Local dev:  http://<your-LAN-ip>:3000  (NOT http://localhost — phone can't reach localhost on dev machine)
# - Production: https://<your-prod-domain>
EXPO_PUBLIC_API_BASE_URL="http://192.168.1.10:3000"

# Cloudinary unsigned upload preset (shared with web admin)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME="<cloud-name>"
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET="<unsigned-upload-preset>"
